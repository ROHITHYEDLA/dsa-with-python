#longest consecutive Sequence

class Solution:
    def longestConsecutive(self, nums: List[int]) -> int:
        if not nums:
            return 0
        nums.sort()
        curr=1
        longest=1
        for i in range(1,len(nums)):
            if nums[i]!=nums[i-1]:
                if nums[i]==nums[i-1]+1:
                    curr+=1
                else:
                    longest=max(curr,longest)
                    curr=1
        return max(curr,longest)

#valid palindrome

class Solution:
    def isPalindrome(self, s: str, left=0, right=None) -> bool:
        if right is None:
            s = "".join(char.lower() for char in s if char.isalnum())
            right = len(s) - 1

        if left >= right:
            return True







#424 sliding window(finding largest string possible with replacement by k )

class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        n=len(s)
        left=0
        max_freq=0
        res=0
        freq=defaultdict(int)
        for i in range(n):
            freq[s[i]]+=1
            max_freq=max(max_freq,freq[s[i]])
            while (i-left+1)-max_freq>k:
                freq[s[left]]-=1
                left+=1
            res=max(res,i-left+1)
        return res


            
        

